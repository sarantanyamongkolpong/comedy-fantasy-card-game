#!/usr/bin/env node
/**
 * Build one HTML file that opens from file:// and plays on the real engine.
 *
 *   node web/tools/build-single-html
 *
 * Writes web/dist/playable.html. CSS, the asset manifest, and every manifest
 * file are inlined. Images become data URIs. esbuild bundles the modules.
 */

import { spawnSync } from 'node:child_process';
import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import { dirname, extname, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

const repoRoot = resolve(dirname(fileURLToPath(import.meta.url)), '../..');
const outDir = join(repoRoot, 'web/dist');
const outFile = join(outDir, 'playable.html');
const bundleFile = join(outDir, 'app.bundle.js');

const mime = {
  '.webp': 'image/webp',
  '.png': 'image/png',
  '.svg': 'image/svg+xml',
  '.jpg': 'image/jpeg',
  '.jpeg': 'image/jpeg',
  '.ttf': 'font/ttf',
  '.woff2': 'font/woff2',
};

function dataUri(filePath) {
  const type = mime[extname(filePath).toLowerCase()] ?? 'application/octet-stream';
  const bytes = readFileSync(filePath);
  return `data:${type};base64,${bytes.toString('base64')}`;
}

mkdirSync(outDir, { recursive: true });
// CFCG_ESBUILD points at a local esbuild binary (offline builds); otherwise npx fetches the pinned version.
const esbuildArgs = [join(repoRoot, 'web/js/app.js'), '--bundle', '--format=iife', '--target=es2022', `--outfile=${bundleFile}`];
const built = process.env.CFCG_ESBUILD
  ? spawnSync(process.env.CFCG_ESBUILD, esbuildArgs, { cwd: repoRoot, stdio: 'inherit' })
  : spawnSync('npx', ['--yes', 'esbuild@0.25.0', ...esbuildArgs], { cwd: repoRoot, stdio: 'inherit' });
if (built.status !== 0) process.exit(built.status ?? 1);

const manifest = JSON.parse(readFileSync(join(repoRoot, 'web/assets-manifest.json'), 'utf8'));
for (const asset of manifest.assets ?? []) {
  for (const key of ['path', 'fallback_path']) {
    const rel = asset[key];
    if (!rel || rel.startsWith('data:')) continue;
    asset[key] = dataUri(join(repoRoot, rel));
  }
}

// Inline every stylesheet that web/index.html links, in page order (app, collection, gacha-fx,
// battle-polish, ...), so C/D/E screens keep their styles in the single file.
const indexHtml = readFileSync(join(repoRoot, 'web/index.html'), 'utf8');
const cssFiles = [...indexHtml.matchAll(/<link[^>]+rel="stylesheet"[^>]+href="([^"]+)"/g)].map((match) => match[1]);
function inlineCss(rel) {
  const cssPath = join(repoRoot, 'web', rel);
  if (!existsSync(cssPath)) return '';
  return readFileSync(cssPath, 'utf8').replace(/url\((['"]?)([^)'"]+)\1\)/g, (full, _quote, ref) => {
    if (/^(data:|https?:|#)/.test(ref)) return full;
    const file = resolve(dirname(cssPath), ref);
    if (!existsSync(file)) return full;
    return `url("${dataUri(file)}")`;
  });
}
const css = cssFiles.map(inlineCss).join('\n');
// Manifest fragments imported as JSON (gacha.json, battle-ui.json, ...) keep repo paths such as
// "web/assets/gacha/vfx_n.webp". An iife has no import.meta.url, so those paths would not load from
// file://. Replace each path literal that names a real file with a data URI.
const js = readFileSync(bundleFile, 'utf8').replace(/(["'])((?:web\/)?assets\/[^"'\s]+\.(?:webp|png|svg|jpe?g))\1/g, (full, quote, rel) => {
  const file = join(repoRoot, rel.startsWith('web/') ? rel : `web/${rel}`);
  if (!existsSync(file)) return full;
  return `${quote}${dataUri(file)}${quote}`;
});
const html = `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Comedy Fantasy Card Game</title>
  <style>
${css}
  </style>
</head>
<body>
  <div id="safe-probe"></div>
  <div id="viewport"><div id="stage"></div></div>
  <div id="rotate-overlay" role="dialog" aria-label="Rotate your device">
    <img id="rotate-art" alt="">
    <h1>Turn the kingdom sideways</h1>
    <p>This stage is built for landscape. Portrait is just a very tall joke.</p>
  </div>
  <script>globalThis.__CFCG_MANIFEST = ${JSON.stringify(manifest)};</script>
  <script>${js}</script>
</body>
</html>
`;

writeFileSync(outFile, html);
const bytes = Buffer.byteLength(html);
console.log(`wrote ${outFile} (${bytes} bytes)`);
