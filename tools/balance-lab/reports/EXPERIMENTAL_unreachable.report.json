    "outcome": "engine evaluateOutcome using the supplied defeat predicate"
  },
  "evaluatorDefinitions": {
    "formulaClamp": "minimum is applied first, then maximum when maximum is not null",
    "zeroAmountConsumes": "parameters.damage.incoming.zeroAmountConsumes decides whether a 0 amount clears mitigateNext",
    "repeatSeed": "repeatIndex uses seed + repeatIndex * repeatSeedStep",
    "rng": "mulberry32. Consumption order: seeded SPD tie-break (only when the team totals are equal), side A shuffle when order is seededShuffle, side B shuffle, reshuffles in time order, then a seeded simultaneous resolution if that rule runs",
    "fingerprintExcludes": "turnIndex, roundIndex, and the play log are excluded so a recurring position can be detected",
    "dominanceDenominator": "wins divided by battles in that cell, including unresolved battles. Cells have equal weight. Mirror pairings are included. The observation is per seat because the starting seat can differ",
    "maxSpendableAp": "largest AP from which an in-deck card can still be paid during one turn. Only skills whose grantsAp exceeds their own cost are helpers. The target card occupies a hand slot. The engine assigns base AP at turn start, so grants do not carry to the next turn",
    "healSkipsDefeatedUnlessRevive": "ally heals and buffs include defeated avatars only when hp.revive is true. Damage selections never include them",
    "drawLossSetsHpZero": "loseOnEmptyDraw and loseOnOverflow set that side's experimental HP to 0 so the supplied defeat predicate can run. This is not a second victory type",
    "shieldExpiry": "expireAtStartOfOwnerNextTurn clears shield after the draw and before plays on the owner's later turns, so the shield is present during the opponent's intervening turn",
    "multiTarget": "every target selected at the start of an effect is resolved, then the outcome is evaluated once",
    "actorStatRead": "the actor selector reads parameters.targeting.actorStatRead and does not follow the damage formula's statRead on its own",
    "teamSpdReadsBase": "team SPD aggregation reads stats.spd only and ignores marker bonuses",
    "playThenResolve": "the engine play spends AP and does not apply an effect. The laboratory then calls resolveEffect with the compiled damage or skill rule"
  },
